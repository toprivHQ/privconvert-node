{
  "name": "privconvert",
  "version": "0.3.0",
  "description": "Official Node.js client for the PrivConvert file conversion API. Files are processed in memory and never stored.",
  "license": "MIT",
  "author": "PrivConvert <contact@topriv.com>",
  "homepage": "https://privconvert.com/developers/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toprivHQ/privconvert-node.git"
  },
  "keywords": [
    "privconvert",
    "file conversion",
    "pdf",
    "api",
    "converter",
    "privacy",
    "s3",
    "google cloud storage",
    "azure blob storage",
    "cloudflare r2",
    "backblaze b2"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/fix-cjs.mjs",
    "prepare": "npm run build",
    "test": "npm run build && node --test test/offline.test.mjs",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@azure/identity": "^4.4.0",
    "@azure/storage-blob": "^12.24.0",
    "@google-cloud/storage": "^7.14.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@azure/identity": {
      "optional": true
    },
    "@azure/storage-blob": {
      "optional": true
    },
    "@google-cloud/storage": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "overrides": {
    "undici-types": "6.21.0"
  }
}
